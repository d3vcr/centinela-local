[Unit]
Description=NEXO Centinela v0.1 read-only observer
Wants=network-online.target nexo-api.service
After=network-online.target nexo-api.service

[Service]
Type=simple
User=nexo
Group=nexo
WorkingDirectory=/opt/nexo
Environment=PYTHONPATH=/opt/nexo
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=NEXO_CENTINELA_CURRENT_FRONTEND=/opt/nexo/current-frontend
ExecStart=/usr/bin/python3 -B -m apps.centinela.main
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0027

StateDirectory=nexo/centinela
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/nexo /etc/nexo
ReadWritePaths=/var/lib/nexo/centinela
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexo-centinela

[Install]
WantedBy=multi-user.target
